{
  "name": "codex-pi-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向 Codex 的 pi SDK 子代理与 pi-tui 监控器",
  "engines": { "node": ">=22.19.0" },
  "bin": { "pi-subagents": "dist/cli.js", "cpi-monitor": "dist/monitor-cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "monitor": "node dist/monitor-cli.js",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "typebox": "1.3.27",
    "zod": "^3.25.76"
  },
  "devDependencies": { "@types/node": "^22.19.19", "typescript": "5.9.3" }
}
